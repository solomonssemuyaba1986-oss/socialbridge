rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if request.auth.uid == sellerId;

      match /products/{productId} {
        allow read: if true;
        allow create, delete: if request.auth.uid == sellerId;
        allow update: if request.auth.uid == sellerId
          || (
            request.auth != null
            && request.auth.uid != sellerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderCount'])
            && request.resource.data.orderCount == resource.data.orderCount + 1
          );
      }

      match /stats/{statId} {
        allow read: if true;
        allow write: if request.auth.uid == sellerId;
      }

      match /orders/{orderId} {
        allow read: if request.auth.uid == sellerId
          || (request.auth != null && resource.data.buyerUid == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.buyerUid == request.auth.uid
          && request.resource.data.buyerUid != sellerId
          && request.resource.data.status == 'pending';
        allow update: if request.auth.uid == sellerId
          && resource.data.status in ['pending', 'paid', 'awaiting_payment', 'needs_details']
          && request.resource.data.status in ['fulfilled', 'out_of_stock', 'needs_details'];
        allow delete: if request.auth.uid == sellerId;
      }

      match /visits/{visitId} {
        allow create: if true;
        allow read: if request.auth != null && request.auth.uid == sellerId;
      }

      match /messages/{messageId} {
        // Signed-in buyers can message the seller; guests verify a phone number first
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverUid == sellerId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          || request.auth == null
          && request.resource.data.senderUid is string
          && request.resource.data.senderUid.matches('^guest_')
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderPhone is string
          && request.resource.data.senderPhone.matches('^\\+\\d{8,15}$')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.verified == true
          && request.resource.data.productName is string;
        allow read: if request.auth.uid == sellerId
          || (request.auth != null && resource.data.senderUid == request.auth.uid);
        allow update: if request.auth.uid == sellerId;
      }
    }

    match /events/{eventId} {
      allow create: if true;
      allow read: if false;
    }

    match /bagCounts/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    match /recoveries/{docId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;

      match /bag/{productId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    match /conversations/{conversationId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create, update: if request.auth != null;
        allow delete: if false;
      }
    }

  }
}
