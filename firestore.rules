rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A buyer's own orders, wherever they were placed.
    //
    // A buyer's orders live under a *shop*, so "my orders" is a collection-group question. The
    // rules had no collection-group answer at all until now, so a phone had no way to ask. This is
    // the answer, and it is deliberately the narrowest one possible: still signed in, and only
    // documents whose `buyerUid` is the caller's own uid. Firestore only lets a query through when
    // it can prove that filter, so collectionGroup("orders").where("buyerUid", "==", uid) is
    // allowed while the collection itself stays closed to everyone else. Nothing here loosens a
    // path rule: the shop and the buyer keep exactly the reads they already had.
    match /{path=**}/orders/{orderId} {
      allow read: if request.auth != null && resource.data.buyerUid == request.auth.uid;
    }

    match /sellers/{sellerId} {
      allow read: if true;

      // A seller owns their own shop document — with two exceptions.
      //
      // `phoneVerified` used to be writable here, and that single fact is what made the 🟢 "real
      // seller" badge forgeable: the browser could send `phoneVerified: true` by hand, with no SMS
      // ever sent and nothing to check it against. It is now a *claim about* the seller rather than
      // a setting they own, so they may no longer write it at all. The server is the only writer,
      // and it records the proof in `trust/{uid}` below. The value still on old documents is left
      // untouched — a frozen snapshot of a real Firebase phone-auth result — so shops that earned
      // the badge before this change keep it.
      //
      // `verifiedSeller` is the same bargain again, and it is the strongest claim of the three: a
      // blue tick that says rachett has checked this shop against a real identity. Until now the
      // browser could write it, so any seller could tick themselves blue with no check behind it.
      // It is refused outright now, on create and on update, exactly like `phoneVerified` above:
      // only the server may grant it (firebase-admin or the Firebase console, both of which bypass
      // these rules). Nothing else about the shop changes -- a seller still owns their name, bio,
      // logo and where they are.
      //
      // `ratingAvg` / `ratingCount` / `ratingUpdatedAt` are the same kind of fact: what a shop's
      // own buyers said about it, averaged over every comment it has received. They are written by
      // `recomputeSellerRating` (Cloud Functions) only, because a shop that could write them could
      // award itself ★ 5.0 without a single customer — the exact forgery the badge above was fixed
      // for. The keys are refused outright, on create and on update.
      //
      // `paymentMethods` is the same bargain for payouts: it says which rails are on, and a rail
      // may only be on when `/api/payout/methods` has proved its number with an SMS code. The
      // browser cannot write this field at all, and it never carries the number itself — that
      // lives in `payoutAccounts/{uid}` below, closed to everyone but its owner and the server.
      //
      // ⭐ The rating keys have since been split in two: `ratingWeightSum` is the total weight the
      // average was computed from (three verified stars weigh 3.0, a chat-only star 0.3), and
      // `ratingMathVersion` says which arithmetic produced the number -- `2` is the weighted,
      // decayed, smoothed one in `lib/utils/seller_rating.dart`, and an older document without the
      // stamp carries a plain comment average the phone is told to ignore. Both are refused here
      // for exactly the reason above: the shop must not be able to write its own reputation.
      allow create: if request.auth.uid == sellerId
        && !request.resource.data.keys()
             .hasAny(['phoneVerified', 'verifiedSeller', 'ratingAvg', 'ratingCount', 'ratingUpdatedAt',
                      'ratingWeightSum', 'ratingMathVersion',
                      'paymentMethods', 'paymentMethodsUpdatedAt']);
      allow update: if request.auth.uid == sellerId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['phoneVerified', 'verifiedSeller', 'ratingAvg', 'ratingCount', 'ratingUpdatedAt',
                      'ratingWeightSum', 'ratingMathVersion',
                      'paymentMethods', 'paymentMethodsUpdatedAt']);
      allow delete: if request.auth.uid == sellerId;

      match /products/{productId} {
        allow read: if true;
        allow create, delete: if request.auth.uid == sellerId;
        allow update: if request.auth.uid == sellerId
          || (
            request.auth != null
            && request.auth.uid != sellerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderCount'])
            && request.resource.data.orderCount == resource.data.orderCount + 1
          )
          || (
            // ♥ The public like tally. Any signed-in person may move it by exactly one —
            // up (a new vote) or down (a taken-back vote) — and nothing else. `get()`
            // tolerates products that predate likes and so carry no likeCount yet.
            request.auth != null
            && request.auth.uid != sellerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && (
              request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
              || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
            )
          )
          || (
            // 🗣️ The comment counters. Only a buyer (never the seller) moves them, only by what one
            // comment can move, and only in the same write as their own comment —
            // `existsAfter` is the proof that the comment is landing alongside, so the scoreboard
            // can never drift away from the comments. `reviewScoreSum` moves by the *difference*
            // between the old score and the new one, which is at most 4 either way — a fresh
            // comment adds between 1 and 5 — so ±5 is the whole range one comment can account for.
            request.auth != null
            && request.auth.uid != sellerId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['reviewCount', 'reviewScoreSum'])
            && existsAfter(/databases/$(database)/documents/sellers/$(sellerId)/products/$(productId)/reviews/$(request.auth.uid))
            && request.resource.data.reviewCount is int
            && request.resource.data.reviewScoreSum is int
            && request.resource.data.reviewCount - resource.data.get('reviewCount', 0) >= 0
            && request.resource.data.reviewCount - resource.data.get('reviewCount', 0) <= 1
            && request.resource.data.reviewScoreSum - resource.data.get('reviewScoreSum', 0) >= -5
            && request.resource.data.reviewScoreSum - resource.data.get('reviewScoreSum', 0) <= 5
          );

        // ♥ One vote per account, world-wide: the document ID *is* the voter's uid, so a
        // second like can only ever be an un-like (a delete) — never a duplicate vote.
        match /likes/{voterId} {
          // The tally is public; the votes are just uids, and a page needs to know
          // whether *you* are in here.
          allow read: if true;
          allow create: if request.auth != null
            && request.auth.uid == voterId
            && voterId != sellerId;
          // A vote is never edited — no flip-flopping, no rewriting who voted.
          allow update: if false;
          allow delete: if request.auth != null && request.auth.uid == voterId;
        }

        // ── 🗣️ What buyers said ──────────────────────────────────────────────────────────────
        // Public to read: that is the whole point — what people who actually received it said.
        //
        // Only the buyer may write, the document ID *is* their uid (so one comment each, and a
        // second one is structurally impossible), and the write is authorised by **their own
        // delivered order** — looked up here, in the rules, where it cannot be faked. That is what
        // makes "✓ Bought it" a fact instead of a checkbox the buyer ticked.
        //
        // The rating itself is one whole number from 1 to 5, checked here rather than in the app:
        // a score is what every average on rachett is computed from, and `sellerStats.js` counts a
        // document it cannot read as nothing at all — so a 0, a 4.5 or a 900 would quietly become a
        // missing rating rather than an error anybody could see.
        match /reviews/{buyerUid} {
          allow read: if true;
          allow create, update: if request.auth != null
            && request.auth.uid == buyerUid
            && buyerUid != sellerId
            && request.resource.data.buyerUid == request.auth.uid
            && request.resource.data.verified == true
            && request.resource.data.orderId is string
            && request.resource.data.score is int
            && request.resource.data.score >= 1
            && request.resource.data.score <= 5
            && request.resource.data.text.size() <= 400
            && get(/databases/$(database)/documents/sellers/$(sellerId)/orders/$(request.resource.data.orderId)).data.buyerUid == request.auth.uid
            && get(/databases/$(database)/documents/sellers/$(sellerId)/orders/$(request.resource.data.orderId)).data.status == 'fulfilled';
          // A buyer may take their own comment back. The seller can never touch it — not to edit
          // it, not to delete it — which is the only way a comment stays worth reading.
          allow delete: if request.auth != null && request.auth.uid == buyerUid;
        }

        // ── ⭐ What buyers rated the shop ────────────────────────────────────────────────────
        // A star is about the **seller**, not about one listing. A shop is one reputation: the same
        // number is drawn on every product card, in the product sheet and on the shop page, and no
        // per-product average exists anywhere any more. Comments (`reviews` above) stay per-product
        // and no longer feed this number.
        //
        // One rating per buyer per order, and one per buyer for a chat with no order behind it: the
        // document ID *is* that key (`order_<orderId>` / `chat_<buyerUid>`), so a second rating can
        // only ever replace the first -- it can never stack on top of it.
        //
        // The weight a star carries is not stored here: it is `source` (plus whether a chat rating
        // names an order) read through `lib/utils/seller_rating.dart`. What is checked *here* is the
        // proof behind each source, where it cannot be faked:
        //
        //   order           the buyer's own order, delivered -- the seller marked it `fulfilled`,
        //                   or the buyer tapped "I received it" (see `orders` below)
        //   chat + order    the same proof, three days after the buyer said it arrived, plus a
        //                   thread between these two people -- the fallback for a buyer never asked
        //   chat, no order  a thread the **seller answered** (`conversations/{id}/proofs/
        //                   sellerReplied`, which only the seller may create), and one of the
        //                   buyer's daily allowance -- the counter below has to move in the same
        //                   batch, so a star with no tick is refused along with it
        //
        // `createdAt` is a `serverTimestamp`, which the rules see as the moment of the write: a
        // rating cannot be dated to look fresher than it is, and since weight only ever decays with
        // age, dating one backwards can only hurt the person who wrote it.
        match /ratings/{ratingId} {
          function ratedOrder() {
            return get(/databases/$(database)/documents/sellers/$(sellerId)/orders/$(request.resource.data.orderId)).data;
          }
          // Delivered: the seller's own `fulfilled`, or the buyer's own attestation. Either is
          // enough -- a shop that never presses "delivered" must not be able to stop its buyers
          // from rating it.
          function delivered() {
            return ratedOrder().buyerUid == request.auth.uid
              && (ratedOrder().status == 'fulfilled' || ratedOrder().get('receivedAt', 0) > 0);
          }
          // A chat rating that names an order waits **three days** after the buyer said the thing
          // arrived (259200000 ms). The order's own stars are the first ask; this path is the
          // fallback for a buyer who was never asked, so it may not be the quick way out. The wait
          // is measured from the buyer's own attestation because that is the only delivery time an
          // order carries -- which makes it a patience test rather than a proof, and the rating's
          // own date is still the server's.
          function deliveredThreeDaysAgo() {
            return ratedOrder().get('receivedAt', 0) > 0
              && timestamp.value(ratedOrder().receivedAt + 259200000) <= request.time;
          }
          function thread() {
            return get(/databases/$(database)/documents/conversations/$(request.resource.data.threadId)).data;
          }
          // The daily allowance, moved in the same batch as the rating. No counter yet means this
          // is the first one today.
          function quotaMoved() {
            return !exists(/databases/$(database)/documents/users/$(request.auth.uid)/ratingQuota/main)
              ? getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/ratingQuota/main).data.count == 1
              : getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/ratingQuota/main).data.count
                  == get(/databases/$(database)/documents/users/$(request.auth.uid)/ratingQuota/main).data.count + 1;
          }

          // Public to read: the stars are the shop's, and a page has to draw them for a visitor who
          // is not signed in.
          allow read: if true;
          allow create, update: if request.auth != null
            && request.auth.uid != sellerId
            && request.resource.data.buyerUid == request.auth.uid
            && request.resource.data.stars is int
            && request.resource.data.stars >= 1
            && request.resource.data.stars <= 5
            && request.resource.data.createdAt == request.time
            && request.resource.data.source in ['order', 'chat']
            && (
              (
                request.resource.data.source == 'order'
                && ratingId == 'order_' + request.resource.data.orderId
                && delivered()
              )
              || (
                request.resource.data.source == 'chat'
                && ratingId == 'chat_' + request.auth.uid
                && thread().buyerId == request.auth.uid
                && thread().sellerId == sellerId
                && exists(/databases/$(database)/documents/conversations/$(request.resource.data.threadId)/proofs/sellerReplied)
                && (!('orderId' in request.resource.data) || deliveredThreeDaysAgo())
                && ('orderId' in request.resource.data || quotaMoved())
              )
            );
          // A buyer may take their own star back. The seller can never touch one -- not to edit it,
          // not to delete it -- which is the only way the number stays worth reading.
          allow delete: if request.auth != null && request.auth.uid == resource.data.buyerUid;
        }
      }

      // The 💎 Reliable Seller numbers — completion rate and average first-reply time. They are
      // rachett's own measurements, kept in the one place a seller cannot reach: `functions/
      // sellerStats.js` computes them and writes them with `firebase-admin`, which bypasses these
      // rules. A seller may read their own numbers (and the store page shows the badge derived
      // from them to everyone), but writing them by hand would let a shop award itself the badge,
      // so the browser's pen is taken away entirely.
      match /stats/{statId} {
        allow read: if true;
        allow write: if false;
      }

      match /orders/{orderId} {
        allow read: if request.auth.uid == sellerId
          || (request.auth != null && resource.data.buyerUid == request.auth.uid);
        // Every order starts as the buyer's hidden draft. The server publishes it on payment (or
        // when the buyer chooses pay-on-delivery); a browser is never allowed to do that itself.
        allow create: if request.auth != null
          && request.resource.data.buyerUid == request.auth.uid
          && request.resource.data.buyerUid != sellerId
          && request.resource.data.status == 'pending'
          && request.resource.data.checkoutState == 'paying'
          && request.resource.data.read == true;
        // The seller's own half: moving an order along, deciding a return, and asking for a rating.
        // They are separate on purpose — a delivered order is closed to everything except those, so
        // nothing can walk back out of "fulfilled" by accident.
        allow update: if request.auth.uid == sellerId
          && (!('checkoutState' in resource.data) || resource.data.checkoutState != 'paying')
          && (
            (resource.data.status in ['pending', 'paid', 'awaiting_payment', 'needs_details']
             && request.resource.data.status in ['fulfilled', 'out_of_stock', 'needs_details'])
            || (
              resource.data.status == 'fulfilled'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['returnState', 'returnNote', 'returnDecidedAt'])
              && request.resource.data.returnState in ['photos_needed', 'approved', 'declined', 'refunded', 'completed']
              && (!('returnNote' in request.resource.data) || request.resource.data.returnNote.size() <= 300)
            )
            || (
              // ⭐ The only other thing a seller may add to a delivered order: "rate it". Write-once,
              // so nobody can be asked again and again — and it deliberately carries no `updatedAt`,
              // because asking for a rating must not move the delivery date the return window and
              // the seller's own completion numbers are counted from.
              resource.data.status == 'fulfilled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewAskedAt'])
              && !('reviewAskedAt' in resource.data)
              && request.resource.data.reviewAskedAt is int
            )
          );
        // ↩️ The buyer's half of a return. Only these six fields, only on their own delivered order,
        // only while no seller decision is standing, and the request time is write-once so the
        // 48-hour clock cannot be restarted. Every value is checked here, not in the app: the buyer
        // is the side with a reason to bend the truth. `returnFault` is *derived* from the reason,
        // so a change of mind cannot be filed as the seller's fault to move the shipping cost.
        allow update: if request.auth != null
          && resource.data.buyerUid == request.auth.uid
          && resource.data.status == 'fulfilled'
          && resource.data.get('returnState', '') in ['', 'requested', 'photos_sent', 'canceled']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['returnState', 'returnReason', 'returnFault', 'returnNote',
                         'returnRequestedAt', 'returnUpdatedAt'])
          && request.resource.data.returnState in ['requested', 'photos_sent', 'canceled']
          && request.resource.data.returnReason in ['damaged', 'wrong_item', 'not_as_described',
                                                    'missing_parts', 'never_arrived', 'too_late',
                                                    'changed_mind', 'other']
          && (
            (request.resource.data.returnReason in ['damaged', 'wrong_item', 'not_as_described',
                                                    'missing_parts', 'never_arrived', 'too_late']
             && request.resource.data.returnFault == 'seller')
            || (request.resource.data.returnReason in ['changed_mind', 'other']
                && request.resource.data.returnFault in ['seller', 'buyer'])
          )
          && (!('returnNote' in request.resource.data) || request.resource.data.returnNote.size() <= 300)
          && request.resource.data.returnRequestedAt is number
          && (
            resource.data.get('returnRequestedAt', 0) == 0
            || request.resource.data.returnRequestedAt == resource.data.get('returnRequestedAt', 0)
          );
        // 📦 "I received it" -- the buyer's own word that the thing arrived, and the proof an order
        // rating stands on (`sellers/{id}/ratings` above). Two fields, write-once, on their own
        // order, and deliberately *not* `status`: the shop's completion rate and the 48-hour return
        // window stay the seller's own business, and an order still being paid for is not something
        // anybody has received. The value is the buyer's clock, which is fine -- it is an
        // attestation, not a measurement; the rating's own date is the server's.
        allow update: if request.auth != null
          && resource.data.buyerUid == request.auth.uid
          && resource.data.get('checkoutState', '') != 'paying'
          && !('receivedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAt', 'receivedBy'])
          && request.resource.data.receivedAt is int
          && request.resource.data.receivedAt > 0
          && request.resource.data.receivedBy == 'buyer';
        allow delete: if request.auth.uid == sellerId;
      }

      match /visits/{visitId} {
        allow create: if true;
        allow read: if request.auth != null && request.auth.uid == sellerId;
      }

      match /messages/{messageId} {
        // Signed-in buyers can message the seller; guests verify a phone number first
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverUid == sellerId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          || request.auth == null
          && request.resource.data.senderUid is string
          && request.resource.data.senderUid.matches('^guest_')
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderPhone is string
          && request.resource.data.senderPhone.matches('^\\+\\d{8,15}$')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.verified == true
          && request.resource.data.productName is string;
        allow read: if request.auth.uid == sellerId
          || (request.auth != null && resource.data.senderUid == request.auth.uid);
        allow update: if request.auth.uid == sellerId;
      }
    }

    // ── 🎬 Shoppertainment — the video channel ──────────────────────────────────
    //
    // A post is a short vertical video, or a carousel of up to ten photos and videos, that a shop
    // published about something it sells. It lives at the top level rather than under its shop so
    // the channel can be one query — `published == true`, newest first, paged — instead of a walk
    // over every shop. The shop keeps every read it already had; nothing under `sellers/` moves.
    //
    // The shop's own facts are **copied onto the post** (`sellerName`, `sellerVerified`,
    // `productName`, `productPrice` …) so a slide draws without a read per card. The copy is a
    // label, never authority: the ✓ and the ★ are still whatever `sellers/{sellerId}` and
    // `trust/{uid}` say, exactly as the store page reads them.
    //
    // Nothing here is taken on the browser's word, so the shape is pinned at create: who authored
    // it, that it is published, that it starts at zero ♥ and 💬, at most ten media items, and a
    // caption that fits. `createdAt` must be a real timestamp, because the feed orders on it.
    //
    // Drafts are **not** here. The Studio keeps an unfinished post in the seller's own phone until
    // Publish writes it, so there is no half-finished document for anyone to read or guess.
    match /shoppertainment/{postId} {
      function isAuthor() {
        return request.auth != null && request.auth.uid == resource.data.sellerId;
      }

      // Public, like `products` and `reviews`: the channel is the shop window. A post is removed by
      // deleting it — by its author, or by the server for a takedown — not by a flag a reader could
      // be shown a stale copy of.
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.media is list
        && request.resource.data.media.size() > 0
        && request.resource.data.media.size() <= 10
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 300
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt is timestamp;

      // The author's own pen: words, cover, the product it tags, the media list — but never the
      // tallies, never the author, never the moment it was published.
      allow update: if isAuthor()
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['likeCount', 'commentCount', 'sellerId', 'createdAt'])
      // ♥ The public like tally: any signed-in person, one at a time, never the author themselves.
      || (
        request.auth != null
        && request.auth.uid != resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (
          request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
          || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
        )
      )
      // 🗣️ The comment tally, moved only in the same write as the comment itself — `existsAfter` is
      // the proof, so the number under a video can never drift away from what people said.
      || (
        request.auth != null
        && request.auth.uid != resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && existsAfter(/databases/$(database)/documents/shoppertainment/$(postId)/comments/$(request.auth.uid))
        && request.resource.data.commentCount - resource.data.get('commentCount', 0) >= 0
        && request.resource.data.commentCount - resource.data.get('commentCount', 0) <= 1
      );

      allow delete: if isAuthor();

      // ♥ One vote per account: the document ID *is* the voter's uid, so a second ♥ can only be an
      // un-♥ (a delete) — never a duplicate vote. Same bargain as the product likes above.
      match /likes/{voterId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == voterId
          && voterId != get(/databases/$(database)/documents/shoppertainment/$(postId)).data.sellerId;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == voterId;
      }

      // 🗣️ A comment: public to read, written by its own author only, and never editable by the shop
      // it is about. One document per commenter — the uid *is* the ID — is what makes the count
      // above provable.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update, delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }

    match /events/{eventId} {
      allow create: if true;
      allow read: if false;
    }

    match /bagCounts/{productId} {
      allow read: if true;
      allow write: if request.auth != null;

      // One marker per user → the ever-bagged counter counts distinct people, not add-events.
      match /baggers/{key} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == key;
      }
    }

    // 👀 How many times a product has been opened — the one number the seller's Marketing page needs
    // and could not have: `events/` is unreadable by any browser, so a client-side count needs its own
    // home. Same bargain as `bagCounts` above: public to read, signed-in to move, **up by exactly one
    // and nothing else**. A seller cannot wind their own numbers back, cannot write a number in, and
    // no uid is stored here at all — the "have I counted this session?" marker lives in the opener's
    // own browser (`viewOnce.ts`), not in Firestore.
    match /productViews/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is int;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ── 📺 Lives ──────────────────────────────────────────────────────────────
    // The live room, as the *phone* writes it (`LiveWrites` in rachett). Until this block existed the
    // collection had no rule at all, so every write was refused and a seller could tap "Go live" for
    // ever without a room appearing. The shape below is the shape the app writes, field for field:
    // a field added there without being added here is a live nobody can start.
    //
    // Three separate hands are allowed, and they are deliberately not the same permission:
    // the seller opens the room and may only move what the room is looking at; anyone, guest
    // included, may add one heart and nothing else; nobody may delete a live, because a room that
    // can be erased is a room where a seller can erase what a buyer saw.
    //
    // One rules file, both clients: the phone ships no copy of its own, so a deploy from this
    // folder is what the web *and* rachett get. Nothing to keep in step but this.
    match /lives/{liveId} {
      function signedIn() { return request.auth != null; }
      function touches(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      // Anyone may watch, signed in or not. A live is a shop window.
      allow read: if true;

      // A seller opens a live in their own name. The counters start at zero because only the
      // increments below may move them — a seller cannot open a room that already claims 400 viewers.
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'live'
        && request.resource.data.viewerCount == 0
        && request.resource.data.likeCount == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.pinnedProductId is string
        && request.resource.data.products is list
        && request.resource.data.products.size() <= 40
        && request.resource.data.keys().hasOnly([
             'sellerId', 'sellerName', 'sellerSlug', 'title', 'pinnedProductId',
             'products', 'status', 'viewerCount', 'likeCount', 'startedAt',
             'lastSeen'
           ]);

      // The seller's own hand: what the room is looking at, whether it is still on, and the viewer
      // count its heartbeat counted. `diff().affectedKeys()` is why this is safe — an update that
      // also nudges `likeCount` on the way is refused, not averaged. The name it is under may not be
      // changed afterwards: a room that could be renamed is a room somebody could put another shop's
      // name on.
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && touches(['pinnedProductId', 'status', 'endedAt', 'viewerCount', 'lastSeen'])
        && request.resource.data.status in ['live', 'ended'];

      // One more heart, from anyone including a guest, changing nothing else. A heart is a counter,
      // not a claim: no name, no uid, no history — which is exactly why it can be given away this
      // cheaply.
      allow update: if touches(['likeCount'])
        && request.resource.data.likeCount == resource.data.likeCount + 1;

      allow delete: if false;

      // The chat. Append-only, and only ever in your own name.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.kind in ['chat', 'order']
          && request.resource.data.keys().hasOnly([
               'uid', 'name', 'text', 'kind', 'productId', 'productName',
               'color', 'priceText', 'createdAt'
             ]);
        // What was said stays said. A transcript that could be edited after the fact is not a transcript.
        allow update, delete: if false;
      }

      // Who is in the room, one document per account. Never read from the client — the seller's phone
      // *counts* these, it does not list them, and nobody learns who else is watching from a query.
      match /viewers/{uid} {
        allow read: if false;
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── 🛡️ Rachett care tickets ───────────────────────────────────────────
    // A complaint is written by its author and readable by *nobody else* — not the seller it is
    // about, not another buyer, not a curious onlooker. That is the whole design: a buyer should
    // never have to weigh "will this get me my money back" against "will this annoy the seller".
    // Nothing here is ever posted into a chat, and nothing is editable — a ticket is a record.
    match /careTickets/{ticketId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.source == 'care'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 900
        && request.resource.data.status == 'open';
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /recoveries/{docId} {
      allow read, write: if false;
    }

    // ── 📱 A phone number somebody actually proved ──────────────────────────────
    //
    // The badge asks one question that must never be answerable by the person being asked: can
    // they receive an SMS on the number they advertise? So the answer is written where they cannot
    // reach it. Only the server holds a service-account key, and only the server writes here — see
    // `api/_lib/identity.js`, which does it after a code that was texted to the number came back
    // correct.
    match /trust/{userId} {
      // Open to everyone, deliberately: a store page is public and shareable, and its badge has to
      // draw for a visitor who is not signed in. That is exactly why this document must hold no
      // phone number — only the fact of the proof, a timestamp, and which flow made it. The number
      // itself lives nowhere the browser can read it.
      allow read: if true;
      allow write: if false;
    }

    // ── 💸 A seller's verified payout numbers ──────────────────────────────────
    //
    // The number a payout goes to is more sensitive than the shop's public contact number, so it
    // does not live on `sellers/{uid}`. Only `/api/payout/methods` writes here, and only after a
    // code texted to that number came back correct. The seller may read their own record so the
    // Payouts page can show what it saved; nobody else — not another seller, not a buyer, not a
    // visitor — can. `firebase-admin` bypasses rules, which is the separation being drawn.
    match /payoutAccounts/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ── 🔢 One-time codes, their counters, and the number→account ledger ───────
    //
    // Closed to the browser without exception. `otpCodes/{phoneKey}` holds the hashed code, its
    // salt, its expiry and the send counters; `meta/otpSends` counts the day; `phones/{phoneKey}`
    // records which account owns a number. The client never reads or writes any of it — it asks
    // the API to send, and to verify, and the API is the only thing that touches these.
    // `firebase-admin` bypasses rules entirely, which is precisely the separation being drawn.
    //
    // The document keys are HMACs of the numbers (`phoneKey` in `api/_lib/otp.js`), so even a dump
    // of these collections is a list of opaque strings, not a list of who signed up.
    match /otpCodes/{phoneKey} { allow read, write: if false; }
    match /meta/{docId}        { allow read, write: if false; }
    match /phones/{phoneKey}   { allow read, write: if false; }

    // Per-account contact-lookup counters. Closed like the OTP collections: the numbers being
    // matched are never stored here, only how often this account has looked.
    match /contactLookups/{userId} { allow read, write: if false; }

    // Per-caller counters for "does this number already have an account?" (`api/otp/lookup`).
    // Closed for the same reason, and the document key is an HMAC of the caller's address with
    // the OTP pepper -- so this collection names neither a person nor a phone number.
    match /lookupChecks/{callerKey} { allow read, write: if false; }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;

      match /bag/{productId} {
        allow read, write: if request.auth.uid == userId;
      }

      // ♥ My own votes (productId → where), so every page can draw its hearts from a
      // single listener instead of one read per card.
      match /likes/{productId} {
        allow read, write: if request.auth.uid == userId;
      }

      // 🗣️ My own comments, indexed (productId → where), so a later rename knows exactly which
      // published comments to relabel without a collection-group query. Owner-only — nobody else can
      // read your index. The document is written in the **same batch** as the comment itself, so
      // without this rule a comment could not be posted at all: the whole batch is refused.
      match /comments/{productId} {
        allow read, write: if request.auth.uid == userId;
      }

      // ⭐ "We have asked you about this order." Keyed by the order's document id, so the quiet
      // fallback on My Orders offers the stars exactly once. A different question from the ♥ answer
      // below, and stored apart from it on purpose: one must never silence the other.
      match /ratingAsks/{orderId} {
        allow read, write: if request.auth.uid == userId;
      }

      // ⭐ "How many chat-only ratings I have left today."
      //
      // The allowance is `SellerRatingRules.chatRatingsPerDay` = 3 in `lib/utils/seller_rating.dart`
      // and the number is repeated here on purpose: the rules are the side that has to hold, and
      // `_rating_rules_check.cjs` reads both to make sure they still agree.
      //
      // A rating that comes from an order needs no allowance -- the delivery is its proof. This
      // counter exists for the weakest source only, where "we chatted" is all anybody has proved,
      // so a buyer may leave three of those a day and no more. The rating write above has to move
      // this counter in the same batch, so a star with no tick fails with it.
      //
      // `day` is the UTC midnight the bucket belongs to, and three things hold because of it:
      //
      //   * the bucket must be *today's* (`day <= request.time < day + 1d`), so a stale counter
      //     cannot quietly accumulate beside a fresh one;
      //   * a new bucket may only ever move `day` forward, and it starts at one -- so within one
      //     day there is exactly one reset available, and after it the buyer is pinned to ticking
      //     1, 2, 3;
      //   * deleting the counter is refused, because that would be a free reset.
      match /ratingQuota/{docId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId
          && docId == 'main'
          && request.resource.data.day is timestamp
          && request.resource.data.count == 1
          && request.resource.data.day <= request.time
          && request.time < request.resource.data.day + duration.value(1, 'd');
        allow update: if request.auth.uid == userId
          && docId == 'main'
          && request.resource.data.day is timestamp
          && request.resource.data.day <= request.time
          && request.time < request.resource.data.day + duration.value(1, 'd')
          && (
            (
              request.resource.data.day == resource.data.day
              && request.resource.data.count == resource.data.count + 1
              && request.resource.data.count <= 3
            )
            || (
              request.resource.data.day > resource.data.day
              && request.resource.data.count == 1
            )
          );
        allow delete: if false;
      }

      // "Did you love it?" answers we have already asked about — so we never nag twice.
      match /loveAnswers/{orderId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ── Private buyer↔seller chats ─────────────────────────────────────────
    // A thread belongs to exactly two people. Nobody else — not other buyers,
    // not other sellers, not a curious onlooker — can read or touch it.
    match /conversations/{conversationId} {
      function signedIn() {
        return request.auth != null;
      }
      // Is the caller one of the two people on the *stored* thread?
      function isParticipant() {
        return signedIn()
          && (request.auth.uid == resource.data.sellerId
              || request.auth.uid == resource.data.buyerId);
      }
      // Does the write leave the caller on the thread? (Stops handing a thread
      // to someone else, or editing yourself out of it.)
      function staysParticipant() {
        return signedIn()
          && (request.auth.uid == request.resource.data.sellerId
              || request.auth.uid == request.resource.data.buyerId);
      }

      // `resource == null` = "does this thread exist yet?" — the client asks
      // before creating it, and a missing document returns no data either way.
      allow read: if signedIn() && (resource == null || isParticipant());
      allow create: if staysParticipant();
      allow update: if isParticipant() && staysParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        // Participation is read from the thread itself, never trusted from the
        // message being written.
        function inThread() {
          return signedIn()
            && (request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId
                || request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.buyerId);
        }

        allow read: if inThread();
        // You may only post as yourself.
        allow create: if inThread()
          && request.resource.data.senderId == request.auth.uid;
        // Only the *other* person may change a message (read receipts).
        allow update: if inThread()
          && resource.data.senderId != request.auth.uid;
        allow delete: if false;
      }

      // ⭐ The one fact a chat rating is authorised by: the seller answered this thread.
      //
      // It lives in its own write-once document rather than as a field on the thread, because a
      // thread is writable by *both* of its people (`allow update` above is deliberately loose --
      // read receipts, last message, unread counts) and the buyer must not be able to stamp it on
      // the seller's behalf. Only the seller of this thread may create it, nobody may change it,
      // and nobody may remove it. The rating rule reads its *existence*, not its value.
      match /proofs/{proofId} {
        function thread() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow read: if request.auth != null
          && (request.auth.uid == thread().sellerId || request.auth.uid == thread().buyerId);
        allow create: if request.auth != null
          && request.auth.uid == thread().sellerId
          && proofId == 'sellerReplied'
          && request.resource.data.at is int
          && request.resource.data.at > 0;
        allow update, delete: if false;
      }
    }

  }
}
