rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can read public seller logos
    match /sellers/{sellerId}/logo.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }

    // Private documents (National ID): only the seller can read/write
    match /sellers/{sellerId}/private/{fileName} {
      allow read: if request.auth != null && request.auth.uid == sellerId;
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}