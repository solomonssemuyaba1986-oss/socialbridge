# ── Server-only secrets for the phone-verification API (api/otp/*) ────────────
# Copy this file to `.env.local` (already git-ignored) and fill in the values,
# or copy the same names into Vercel → Settings → Environment Variables.
#
# NEVER prefix any of these with VITE_ — Vite inlines every VITE_* variable into
# the browser bundle, which would hand the key to every visitor of the site.

# ── Yoola SMS (yoolasms.com → Developers / API) ───────────────────────────────
YOOLA_API_KEY=68dsK303h920kz6jkZhA99nzf619dS6SzZy37AG8vRsah49Li1C99X1d7rGEdVnE

# The sender ID (the name the SMS arrives from), once Yoola has approved it.
# Leave blank to send from whatever your account defaults to.
YOOLA_SENDER_ID=

# Where the send endpoint lives. Only change this if Yoola moves you.
YOOLA_API_URL=https://yoolasms.com/api/v1/send_sms

# ── One-time codes ────────────────────────────────────────────────────────────
# A long random string the codes are hashed with, so the database never holds a
# code anyone could read. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every code in flight at that moment — which is the
# whole point of owning it.
OTP_PEPPER=

# The most codes the server will send in one day (UTC). A cost rail, not a
# target: 200 × UGX 35 ≈ UGX 7,000. Raise it deliberately, never by accident.
OTP_DAILY_CAP=200

# ── Firebase Admin (the server's own identity) ────────────────────────────────
# Local development: a path to the downloaded service-account file.
GOOGLE_APPLICATION_CREDENTIALS=.secrets/service-account.json

# On Vercel there are no files, so the key travels as a variable instead.
# One line, no newline damage:  base64 -w0 .secrets/service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Same thing, if you would rather paste the JSON itself (keep the \n escapes).
FIREBASE_SERVICE_ACCOUNT_JSON=








