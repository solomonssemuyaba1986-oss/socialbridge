rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /sellers/{sellerId} {
      allow read: if true;

      // A seller owns their own shop document — with one exception.
      //
      // `phoneVerified` used to be writable here, and that single fact is what made the 🟢 "real
      // seller" badge forgeable: the browser could send `phoneVerified: true` by hand, with no SMS
      // ever sent and nothing to check it against. It is now a *claim about* the seller rather than
      // a setting they own, so they may no longer write it at all. The server is the only writer,
      // and it records the proof in `trust/{uid}` below. The value still on old documents is left
      // untouched — a frozen snapshot of a real Firebase phone-auth result — so shops that earned
      // the badge before this change keep it.
      allow create: if request.auth.uid == sellerId
        && !request.resource.data.keys().hasAny(['phoneVerified']);
      allow update: if request.auth.uid == sellerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phoneVerified']);
      allow delete: if request.auth.uid == sellerId;

      match /products/{productId} {
        allow read: if true;
        allow create, delete: if request.auth.uid == sellerId;
        allow update: if request.auth.uid == sellerId
          || (
            request.auth != null
            && request.auth.uid != sellerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderCount'])
            && request.resource.data.orderCount == resource.data.orderCount + 1
          )
          || (
            // ♥ The public like tally. Any signed-in person may move it by exactly one —
            // up (a new vote) or down (a taken-back vote) — and nothing else. `get()`
            // tolerates products that predate likes and so carry no likeCount yet.
            request.auth != null
            && request.auth.uid != sellerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && (
              request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
              || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
            )
          )
          || (
            // 🗣️ The comment counters. Only a buyer (never the seller) moves them, only by what one
            // comment can move, and only in the same write as their own comment —
            // `existsAfter` is the proof that the comment is landing alongside, so the scoreboard
            // can never drift away from the comments.
            request.auth != null
            && request.auth.uid != sellerId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['reviewCount', 'reviewScoreSum', 'reviewLovedCount'])
            && existsAfter(/databases/$(database)/documents/sellers/$(sellerId)/products/$(productId)/reviews/$(request.auth.uid))
            && request.resource.data.reviewCount is int
            && request.resource.data.reviewScoreSum is int
            && request.resource.data.reviewLovedCount is int
            && request.resource.data.reviewCount - resource.data.get('reviewCount', 0) >= 0
            && request.resource.data.reviewCount - resource.data.get('reviewCount', 0) <= 1
            && request.resource.data.reviewScoreSum - resource.data.get('reviewScoreSum', 0) >= -5
            && request.resource.data.reviewScoreSum - resource.data.get('reviewScoreSum', 0) <= 5
            && request.resource.data.reviewLovedCount - resource.data.get('reviewLovedCount', 0) >= -1
            && request.resource.data.reviewLovedCount - resource.data.get('reviewLovedCount', 0) <= 1
          );

        // ♥ One vote per account, world-wide: the document ID *is* the voter's uid, so a
        // second like can only ever be an un-like (a delete) — never a duplicate vote.
        match /likes/{voterId} {
          // The tally is public; the votes are just uids, and a page needs to know
          // whether *you* are in here.
          allow read: if true;
          allow create: if request.auth != null
            && request.auth.uid == voterId
            && voterId != sellerId;
          // A vote is never edited — no flip-flopping, no rewriting who voted.
          allow update: if false;
          allow delete: if request.auth != null && request.auth.uid == voterId;
        }

        // ── 🗣️ What buyers said ──────────────────────────────────────────────────────────────
        // Public to read: that is the whole point — what people who actually received it said.
        //
        // Only the buyer may write, the document ID *is* their uid (so one comment each, and a
        // second one is structurally impossible), and the write is authorised by **their own
        // delivered order** — looked up here, in the rules, where it cannot be faked. That is what
        // makes "✓ Bought it" a fact instead of a checkbox the buyer ticked.
        match /reviews/{buyerUid} {
          allow read: if true;
          allow create, update: if request.auth != null
            && request.auth.uid == buyerUid
            && buyerUid != sellerId
            && request.resource.data.buyerUid == request.auth.uid
            && request.resource.data.verified == true
            && request.resource.data.orderId is string
            && request.resource.data.reaction in ['love', 'fine', 'bad']
            && request.resource.data.text.size() <= 400
            && get(/databases/$(database)/documents/sellers/$(sellerId)/orders/$(request.resource.data.orderId)).data.buyerUid == request.auth.uid
            && get(/databases/$(database)/documents/sellers/$(sellerId)/orders/$(request.resource.data.orderId)).data.status == 'fulfilled';
          // A buyer may take their own comment back. The seller can never touch it — not to edit
          // it, not to delete it — which is the only way a comment stays worth reading.
          allow delete: if request.auth != null && request.auth.uid == buyerUid;
        }
      }

      // The 💎 Reliable Seller numbers — completion rate and average first-reply time. They are
      // rachett's own measurements, kept in the one place a seller cannot reach: `functions/
      // sellerStats.js` computes them and writes them with `firebase-admin`, which bypasses these
      // rules. A seller may read their own numbers (and the store page shows the badge derived
      // from them to everyone), but writing them by hand would let a shop award itself the badge,
      // so the browser's pen is taken away entirely.
      match /stats/{statId} {
        allow read: if true;
        allow write: if false;
      }

      match /orders/{orderId} {
        allow read: if request.auth.uid == sellerId
          || (request.auth != null && resource.data.buyerUid == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.buyerUid == request.auth.uid
          && request.resource.data.buyerUid != sellerId
          && request.resource.data.status == 'pending';
        // The seller's own half: moving an order along, and deciding a return once it is delivered.
        // The two are separate on purpose — a delivered order is closed to everything except the
        // return decision, so nothing can walk back out of "fulfilled" by accident.
        allow update: if request.auth.uid == sellerId
          && (
            (resource.data.status in ['pending', 'paid', 'awaiting_payment', 'needs_details']
             && request.resource.data.status in ['fulfilled', 'out_of_stock', 'needs_details'])
            || (
              resource.data.status == 'fulfilled'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['returnState', 'returnNote', 'returnDecidedAt'])
              && request.resource.data.returnState in ['photos_needed', 'approved', 'declined', 'refunded', 'completed']
              && (!('returnNote' in request.resource.data) || request.resource.data.returnNote.size() <= 300)
            )
          );
        // ↩️ The buyer's half of a return. Only these six fields, only on their own delivered order,
        // only while no seller decision is standing, and the request time is write-once so the
        // 48-hour clock cannot be restarted. Every value is checked here, not in the app: the buyer
        // is the side with a reason to bend the truth. `returnFault` is *derived* from the reason,
        // so a change of mind cannot be filed as the seller's fault to move the shipping cost.
        allow update: if request.auth != null
          && resource.data.buyerUid == request.auth.uid
          && resource.data.status == 'fulfilled'
          && resource.data.get('returnState', '') in ['', 'requested', 'photos_sent', 'canceled']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['returnState', 'returnReason', 'returnFault', 'returnNote',
                         'returnRequestedAt', 'returnUpdatedAt'])
          && request.resource.data.returnState in ['requested', 'photos_sent', 'canceled']
          && request.resource.data.returnReason in ['damaged', 'wrong_item', 'not_as_described',
                                                    'missing_parts', 'never_arrived', 'too_late',
                                                    'changed_mind', 'other']
          && (
            (request.resource.data.returnReason in ['damaged', 'wrong_item', 'not_as_described',
                                                    'missing_parts', 'never_arrived', 'too_late']
             && request.resource.data.returnFault == 'seller')
            || (request.resource.data.returnReason in ['changed_mind', 'other']
                && request.resource.data.returnFault in ['seller', 'buyer'])
          )
          && (!('returnNote' in request.resource.data) || request.resource.data.returnNote.size() <= 300)
          && request.resource.data.returnRequestedAt is number
          && (
            resource.data.get('returnRequestedAt', 0) == 0
            || request.resource.data.returnRequestedAt == resource.data.get('returnRequestedAt', 0)
          );
        allow delete: if request.auth.uid == sellerId;
      }

      match /visits/{visitId} {
        allow create: if true;
        allow read: if request.auth != null && request.auth.uid == sellerId;
      }

      match /messages/{messageId} {
        // Signed-in buyers can message the seller; guests verify a phone number first
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverUid == sellerId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          || request.auth == null
          && request.resource.data.senderUid is string
          && request.resource.data.senderUid.matches('^guest_')
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderPhone is string
          && request.resource.data.senderPhone.matches('^\\+\\d{8,15}$')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.verified == true
          && request.resource.data.productName is string;
        allow read: if request.auth.uid == sellerId
          || (request.auth != null && resource.data.senderUid == request.auth.uid);
        allow update: if request.auth.uid == sellerId;
      }
    }

    match /events/{eventId} {
      allow create: if true;
      allow read: if false;
    }

    match /bagCounts/{productId} {
      allow read: if true;
      allow write: if request.auth != null;

      // One marker per user → the ever-bagged counter counts distinct people, not add-events.
      match /baggers/{key} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == key;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── 🛡️ Rachett care tickets ───────────────────────────────────────────
    // A complaint is written by its author and readable by *nobody else* — not the seller it is
    // about, not another buyer, not a curious onlooker. That is the whole design: a buyer should
    // never have to weigh "will this get me my money back" against "will this annoy the seller".
    // Nothing here is ever posted into a chat, and nothing is editable — a ticket is a record.
    match /careTickets/{ticketId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.source == 'care'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 900
        && request.resource.data.status == 'open';
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /recoveries/{docId} {
      allow read, write: if false;
    }

    // ── 📱 A phone number somebody actually proved ──────────────────────────────
    //
    // The badge asks one question that must never be answerable by the person being asked: can
    // they receive an SMS on the number they advertise? So the answer is written where they cannot
    // reach it. Only the server holds a service-account key, and only the server writes here — see
    // `api/_lib/identity.js`, which does it after a code that was texted to the number came back
    // correct.
    match /trust/{userId} {
      // Open to everyone, deliberately: a store page is public and shareable, and its badge has to
      // draw for a visitor who is not signed in. That is exactly why this document must hold no
      // phone number — only the fact of the proof, a timestamp, and which flow made it. The number
      // itself lives nowhere the browser can read it.
      allow read: if true;
      allow write: if false;
    }

    // ── 🔢 One-time codes, their counters, and the number→account ledger ───────
    //
    // Closed to the browser without exception. `otpCodes/{phoneKey}` holds the hashed code, its
    // salt, its expiry and the send counters; `meta/otpSends` counts the day; `phones/{phoneKey}`
    // records which account owns a number. The client never reads or writes any of it — it asks
    // the API to send, and to verify, and the API is the only thing that touches these.
    // `firebase-admin` bypasses rules entirely, which is precisely the separation being drawn.
    //
    // The document keys are HMACs of the numbers (`phoneKey` in `api/_lib/otp.js`), so even a dump
    // of these collections is a list of opaque strings, not a list of who signed up.
    match /otpCodes/{phoneKey} { allow read, write: if false; }
    match /meta/{docId}        { allow read, write: if false; }
    match /phones/{phoneKey}   { allow read, write: if false; }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;

      match /bag/{productId} {
        allow read, write: if request.auth.uid == userId;
      }

      // ♥ My own votes (productId → where), so every page can draw its hearts from a
      // single listener instead of one read per card.
      match /likes/{productId} {
        allow read, write: if request.auth.uid == userId;
      }

      // "Did you love it?" answers we have already asked about — so we never nag twice.
      match /loveAnswers/{orderId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ── Private buyer↔seller chats ─────────────────────────────────────────
    // A thread belongs to exactly two people. Nobody else — not other buyers,
    // not other sellers, not a curious onlooker — can read or touch it.
    match /conversations/{conversationId} {
      function signedIn() {
        return request.auth != null;
      }
      // Is the caller one of the two people on the *stored* thread?
      function isParticipant() {
        return signedIn()
          && (request.auth.uid == resource.data.sellerId
              || request.auth.uid == resource.data.buyerId);
      }
      // Does the write leave the caller on the thread? (Stops handing a thread
      // to someone else, or editing yourself out of it.)
      function staysParticipant() {
        return signedIn()
          && (request.auth.uid == request.resource.data.sellerId
              || request.auth.uid == request.resource.data.buyerId);
      }

      // `resource == null` = "does this thread exist yet?" — the client asks
      // before creating it, and a missing document returns no data either way.
      allow read: if signedIn() && (resource == null || isParticipant());
      allow create: if staysParticipant();
      allow update: if isParticipant() && staysParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        // Participation is read from the thread itself, never trusted from the
        // message being written.
        function inThread() {
          return signedIn()
            && (request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId
                || request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.buyerId);
        }

        allow read: if inThread();
        // You may only post as yourself.
        allow create: if inThread()
          && request.resource.data.senderId == request.auth.uid;
        // Only the *other* person may change a message (read receipts).
        allow update: if inThread()
          && resource.data.senderId != request.auth.uid;
        allow delete: if false;
      }
    }

  }
}
